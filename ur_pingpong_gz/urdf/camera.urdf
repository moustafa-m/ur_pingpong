<?xml version="1.0"?>
<robot name="camera">
    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.05 0.05 0.05"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <box size="0.05 0.05 0.05"/>
            </geometry>
        </collision>
        <material name="red">
            <color rgba="1.0 0 0 1.0"/>
        </material>
        <inertial>
            <mass value="0.1"/>
            <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
            <inertia
                ixx="0.001"
                ixy="0"
                ixz="0"
                iyy="0.001"
                iyz="0"
                izz="0.001"
            />
        </inertial>
    </link>

   <link name="world" />

    <joint name="camera_joint" type="fixed">
        <parent link="world"/>
        <child link="camera_link"/>
        <origin xyz="1.4 2.35 1.5" rpy="0 0.8 3.14"/>
    </joint>

    <gazebo reference="camera_link">
        <sensor name="camera" type="rgbd_camera">
            <ignition_frame_id>camera_link</ignition_frame_id>
            <camera name="camera">
                <horizontal_fov>1.3962634</horizontal_fov>
                <lens>
                    <intrinsics>
                        <fx>277.1</fx>
                        <fy>277.1</fy>
                        <cx>160.5</cx>
                        <cy>120.5</cy>
                        <s>0</s>
                    </intrinsics>
                </lens>
                <distortion>
                    <k1>0.104207</k1>
                    <k2>-0.255558</k2>
                    <k3>0.128694</k3>
                    <p1>0.000512</p1>
                    <p2>0.000319</p2>
                    <center>0.5 0.5</center>
                </distortion>
                <image>
                    <width>848</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                    <clip>
                        <near>0.01</near>
                        <far>300</far>
                    </clip>
                <depth_camera>
                    <clip>
                        <near>0.1</near>
                        <far>2.0</far>
                    </clip>
                </depth_camera>
                <noise>
                    <type>gaussian</type>
                    <mean>0</mean>
                    <stddev>0.003</stddev>
                </noise>
            </camera>
            <always_on>1</always_on>
            <update_rate>60</update_rate>
            <visualize>0</visualize>
            <topic>camera</topic>
        </sensor>
    </gazebo>
</robot>